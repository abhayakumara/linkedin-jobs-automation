# ─────────────────────────────────────────────────────────────────────────────
# JobPilot environment configuration
# Copy this file to ".env" and fill in the values you have. Nothing is required
# to boot the app — features degrade gracefully when keys are missing.
# ─────────────────────────────────────────────────────────────────────────────

# Local SQLite database (no external DB needed).
DATABASE_URL="file:./dev.db"

# ── AI provider (resume tailoring, cover letters, match scoring, email drafting) ──
# The app is provider-agnostic. Pick ONE provider here; without any configured
# provider it falls back to a keyword-heuristic score and disables AI text gen.
#
#   claude → Anthropic (paid, top quality)
#   groq   → Groq (free + fast, great default)
#   gemini → Google Gemini (generous free tier)
#   custom → your own / self-hosted LLM, or any OpenAI-compatible API
#            (Ollama, LM Studio, vLLM, LocalAI, OpenAI, …)
#
# Leave LLM_PROVIDER blank to auto-pick the first provider you've configured
# (claude → groq → gemini → custom). Upgrading to Claude later is then just a
# matter of adding ANTHROPIC_API_KEY (optionally set LLM_PROVIDER=claude).
LLM_PROVIDER="groq"

# Claude / Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# Groq (free) — https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Custom / self-hosted LLM (OpenAI-compatible endpoint).
# Examples: Ollama → http://localhost:11434/v1  (model e.g. "llama3.1")
#           OpenAI → https://api.openai.com/v1   (model e.g. "gpt-4o-mini")
# API key may be left blank for local servers that don't require one.
CUSTOM_LLM_BASE_URL=""
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_MODEL="llama3.1"

# Optional: max wait (ms) for a single LLM call. Bump this for slow local models.
LLM_TIMEOUT_MS="120000"

# ── Job source: Adzuna (optional, free) ──
# Register at https://developer.adzuna.com/ for a richer, global job feed.
# Remotive & Arbeitnow work with NO key, so this is optional.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Default country for Adzuna search (gb, us, in, ca, au, de, ...).
ADZUNA_COUNTRY="us"

# ── Recruiter outreach email (optional, only needed to actually SEND) ──
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# The "From" name/address shown to recruiters (defaults to SMTP_USER).
SMTP_FROM=""

# ── PDF rendering (optional) ──
# JobPilot renders resume PDFs with Playwright's Chromium. Normally you just run
# `npx playwright install chromium` once and leave this blank. Only set this if
# Chromium lives at a custom path (e.g. a pre-provisioned CI/cloud browser).
PLAYWRIGHT_CHROMIUM_PATH=""

# ── LinkedIn automation (OPT-IN, advanced, at your own risk) ──
# Automating LinkedIn violates its Terms of Service and can get your account
# banned. Disabled by default; enable it in Settings only if you accept the risk.
# Session cookies are captured by running `npm run linkedin:login` (headful).
LINKEDIN_SESSION_PATH="./.linkedin-session.json"
